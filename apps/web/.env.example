# Where apps/api is reachable. NEXT_PUBLIC_ because client components fetch it too.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional. Authorizes POST /api/revalidate (apps/web/src/app/api/revalidate/route.ts),
# which busts the ~60s catalog/product cache on demand. Must match apps/api's
# REVALIDATE_SECRET, which apps/api/src/seed.ts uses to call this route after
# reseeding. Leave blank to disable the route (it responds 501) and just wait out
# the ISR window instead.
REVALIDATE_SECRET=
