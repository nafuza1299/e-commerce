# Neon (or any Postgres). Free tier is enough; a branch per developer is free too.
# https://neon.tech -> project -> Connection string
DATABASE_URL=postgres://user:password@host.neon.tech/catalyst_commerce?sslmode=require

PORT=3001
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Optional, used only by `npm run db:seed` to give products a relevant photo.
# Free key: https://www.pexels.com/api/ — leave blank to keep initials placeholders.
PEXELS_API_KEY=

# Optional, used only by `npm run db:seed` to bust the web app's catalog cache
# immediately after reseeding. Must match apps/web/.env's REVALIDATE_SECRET —
# leave both blank to skip and just wait out the ~60s ISR window instead.
REVALIDATE_SECRET=
